# ENVIO_DESLIGADO=1

# Supabase: projeto "hub-saude" (organização LEPoli, região São Paulo)
# URL e chave publicável são públicas por natureza (vão para o navegador). O banco se protege sozinho:
# com elas só dá para chamar acessar_historico(token) e solicitar_acesso(telefone).
NEXT_PUBLIC_SUPABASE_URL=https://eimnpafybehiylzukoja.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gH2KNK0ODBU2Ua8cdCso-Q_wVgy0ZpD

# Chave secreta: só no servidor (rotas de API do Next.js, extração). Pode tudo. Nunca no navegador nem no Git.
# Pegue em: Supabase > hub-saude > Project Settings > API Keys > secret / service_role
SUPABASE_SERVICE_ROLE_KEY=

# Chat do app (aba Conversar): chave do Google AI Studio (tem cota gratuita). Sem ela, o chat aparece desligado.
